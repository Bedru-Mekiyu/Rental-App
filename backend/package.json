    "init:admin": "node src/scripts/init-admin-user.js",
    "test:email": "node src/scripts/test-email.js",
    "test:2fa": "node src/scripts/test-2fa.js",
    "health:check": "node src/scripts/health-check.js",
    "health:check:live": "node src/scripts/health-check-live.js",
    "health:check:all": "node src/scripts/health-check-all.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@sentry/node": "^9.20.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-ses": "^3.750.0",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.1.0",
    "csv-parser": "3.2.0",
    "date-fns": "4.1.0",
    "dompurify": "3.3.1",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "isomorphic-dompurify": "^2.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "multer": "2.0.2",
    "node-cron": "^3.0.0",
    "node-schedule": "2.1.1",
    "nodemailer": "^8.0.1",
    "qrcode": "^1.5.0",
    "rate-limit-redis": "4.3.1",
    "redis": "5.10.0",
    "sharp": "0.34.5",
    "speakeasy": "^2.0.0",
    "uuid": "13.0.0",
    "winston": "^3.11.0",
    "zod": "^3.24.1"
